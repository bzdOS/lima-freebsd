+}
+
+/*
+ * Destroy the /dev/dri alias created by drm_dev_alias(), if any.  Idempotent:
+ * safe to call on a minor that never got an alias, and safe to call twice.
+ * Called from drm_minor_alloc_release() (drm_drv.c), which runs as a drmm_
+ * action when the drm_device is released — i.e. on drm_dev_put(), including
+ * the drm_dev_put() on a failed probe's error path.
+ */
+void
+drm_dev_alias_free(struct drm_minor *minor)
+{
+	struct cdev *alias;
+
+	if (minor == NULL)
+		return;
+	alias = minor->bsd_alias;
+	if (alias == NULL)
+		return;
+	minor->bsd_alias = NULL;
+	destroy_dev(alias);
 }
 
