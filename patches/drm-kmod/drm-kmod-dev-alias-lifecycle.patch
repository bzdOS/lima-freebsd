+	 *
+	 * Returning the error lets drm_sysfs_minor_alloc()'s existing `goto err`
+	 * unwind report a failure the caller can handle, and destroying the alias
+	 * on release means the retry does not collide in the first place.
+	 */
+	/*
+	 * `buf` is a FORMAT ("dri/renderD%d"), not a finished name -- minor_str
+	 * comes from drm_sysfs.c as "card%d"/"renderD%d"/"accel%d" and the index
+	 * is substituted here. Passing "%s", buf instead produces a device
+	 * literally called /dev/dri/renderD%d, which nothing in userland will
+	 * ever open. (Done exactly that once while adding MAKEDEV_CHECKNAME.)
+	 */
+	error = make_dev_alias_p(MAKEDEV_CHECKNAME, &minor->bsd_alias,
+	    cdevp->cdev, buf, minor->index);
+	if (error != 0) {
