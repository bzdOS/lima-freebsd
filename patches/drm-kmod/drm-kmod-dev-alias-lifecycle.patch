+	 * retried — the normal state of affairs while bringing a new driver up —
+	 * takes the machine down on the retry:
+	 *
+	 *   panic: make_dev_alias_v: bad si_name (error=17, si_name=dri/renderD128)
+	 *     make_dev_alias <- drm_dev_alias <- drm_sysfs_minor_alloc
+	 *     <- drm_minor_alloc <- drm_dev_init <- drm_dev_alloc <- lima_pdev_probe
+	 */
+	struct cdev *bsd_alias;
 #endif
